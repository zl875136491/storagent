# Storagent 环境变量配置示例
# 复制为 .env 并填写实际值：cp .env.example .env

# ========== JWT 认证 ==========
# 全局密钥，多节点部署需保持一致
SECRET_KEY=your-secret-key-here
BCRYPT_SALT=$2b$04$your-static-bcrypt-salt

# ========== 服务配置 ==========
SERVER_HOST=localhost
SERVER_PORT=9000
PUBLIC_SCHEME=http
OBJECT_LOCATE_TIMEOUT=5.0
DEBUG=false
RELOAD=false
INIT_SERVICE=true
ENABLE_DOCS=false

# ========== 区域标识（每个节点唯一） ==========
REGION=beijing
REGION_NAME=北京

# ========== MongoDB ==========
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=user
MONGO_DB_PASSWD=passwd
MONGO_DB_NAME=storagent
MONGO_DB_AUTH_SOURCE=admin

# ========== MinIO（本地节点） ==========
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=passwd
MINIO_REPLICATE_WEIGHT=0

# ========== Etcd（服务协调） ==========
ETCD_HOST=localhost
ETCD_PORT=2379
ETCD_USERNAME=admin
ETCD_PASSWORD=passwd

# ========== 跨区域控制面同步 ==========
# 仅首次拓扑布局引导使用；初始化完成后所有区域均可通过 Etcd 更新布局
SYNC_AUTHORITY_REGION=beijing
SYNC_RECONCILE_INTERVAL_SECONDS=30

# ========== 日志 ==========
LOG_PATH=logs/
LOG_STD_LEVEL=INFO
LOG_STORAGE_LEVEL=INFO
LOG_STORAGE_DAYS=30

# ========== 企业 SSO（可选） ==========
IGNORE_AUTH=false
USER_INFO_URL=http://your-sso-server/api/v1/get_user

# ========== OA IM 身份验证 ==========
SPRINGBOARD_URL=http://tl.cooacloud.com/springboard_v3/
SPRINGBOARD_APP=storagent
FRONT_URL=http://stor.1oa.com.cn
OA_AUTH_CODE_EXPIRE_MINUTES=15
OA_AUTH_SEND_RETRIES=3

# ========== CORS ==========
# 生产环境必须配置具体域名，禁止 ["*"]
BACKEND_CORS_ORIGINS=["https://admin.example.com"]
