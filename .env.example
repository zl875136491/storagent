# Storagent 环境变量配置示例
# 复制为 .env 并填写实际值：cp .env.example .env

# ========== JWT 认证 ==========
# 全局密钥，多节点部署需保持一致
SECRET_KEY=your-secret-key-here
BCRYPT_SALT=$2b$04$your-static-bcrypt-salt

# ========== 服务配置 ==========
SERVER_HOST=localhost
SERVER_PORT=9000
PUBLIC_SCHEME=http
# 对外 Nginx 网关域名（不含协议、端口和路径）；生产多区域统一为 stor.1oa.com.cn
PUBLIC_DOMAIN=stor.1oa.com.cn
OBJECT_LOCATE_TIMEOUT=5.0
DEBUG=false
RELOAD=false
INIT_SERVICE=true
ENABLE_DOCS=false

# ========== 区域标识（每个节点唯一） ==========
REGION=beijing
REGION_NAME=北京

# ========== MongoDB ==========
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USER=user
MONGO_DB_PASSWD=passwd
MONGO_DB_NAME=storagent
MONGO_DB_AUTH_SOURCE=admin

# ========== Celery（异步运维任务 / 归档 / 审计） ==========
# 留空时使用上面的 MongoDB 配置作为 broker 与结果库；单机开发可关闭。
CELERY_ENABLED=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_MONGODB_DATABASE=storagent_celery
CELERY_MONGODB_MESSAGES_COLLECTION=celery.messages
CELERY_MONGODB_ROUTING_COLLECTION=celery.routing
CELERY_MONGODB_QUEUES_COLLECTION=celery.queues
CELERY_MONGODB_RESULT_COLLECTION=celery_taskmeta
# Worker compatibility alias. Keep it equal to CELERY_MONGODB_DATABASE.
CELERY_MONGODB_RESULT_DATABASE=storagent_celery
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2
AUTH_CLEANUP_INTERVAL_SECONDS=3600

# ========== MinIO（本地节点） ==========
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=passwd
MINIO_REPLICATE_WEIGHT=0

# ========== Etcd（服务协调） ==========
ETCD_HOST=localhost
ETCD_PORT=2379
# Optional comma-separated endpoints for Etcd 运维状态检查；留空时使用内置五节点默认列表。
ETCD_ENDPOINTS=
ETCD_USERNAME=admin
ETCD_PASSWORD=passwd
ETCD_HEALTH_TIMEOUT_SECONDS=3
ETCD_HEALTH_CACHE_TTL_SECONDS=30
ETCD_RAFT_LAG_WARNING=100
ETCD_RAFT_LAG_CRITICAL=1000
ETCD_SNAPSHOT_DIR=/tmp/storagent-etcd-snapshots
ETCD_SNAPSHOT_MAX_BYTES=1073741824

# ========== 跨区域控制面同步 ==========
# 仅首次拓扑布局引导使用；初始化完成后所有区域均可通过 Etcd 更新布局
SYNC_AUTHORITY_REGION=beijing
SYNC_RECONCILE_INTERVAL_SECONDS=30
REPLICATION_RECONCILE_INTERVAL_SECONDS=300

# ========== 存储运维 ==========
# 服务器递归文件清单缓存 10 分钟；过期记录会主动删除并重新读取 MinIO
SERVER_DETAILS_CACHE_TTL_SECONDS=600
# 管理员应急下载链接有效期（运行时限制为 30-900 秒，且只能成功兑换一次）
ONE_TIME_DOWNLOAD_TTL_SECONDS=300
MINIO_OPERATION_TIMEOUT_SECONDS=20
# 软删除对象的可恢复期结束后，后台任务会先复制到归档桶并校验，再删除源版本。
OBJECT_RECOVERY_PERIOD_DAYS=30
OBJECT_ARCHIVE_BUCKET=storagent-expired-archive
# Internal archive retention; current and non-current archive versions expire
# through the archive bucket lifecycle after this many days.
OBJECT_ARCHIVE_RETENTION_DAYS=365
OBJECT_ARCHIVE_INTERVAL_SECONDS=300
OBJECT_ARCHIVE_BATCH_SIZE=50
OBJECT_ARCHIVE_RETRY_SECONDS=300
APPLICATION_QUOTA_USAGE_CACHE_SECONDS=60
APPLICATION_QUOTA_USAGE_MAX_CONCURRENCY=4
# Celery authority refreshes legacy application usage into the Etcd aggregate.
APPLICATION_QUOTA_AGGREGATE_INTERVAL_SECONDS=3600
# 分片上传配额预留有效期；每个成功分片会续期
APPLICATION_QUOTA_RESERVATION_TTL_SECONDS=86400
# 单 APP 活动上传预留上限，避免 Etcd 单值无限增长
APPLICATION_QUOTA_MAX_ACTIVE_RESERVATIONS=1000
# 单个 multipart 分片的最大字节数；请求体会在解析前拦截
APPLICATION_UPLOAD_MAX_PART_BYTES=67108864
# 单进程最多同时读取并写入 MinIO 的分片数，限制峰值内存
APPLICATION_UPLOAD_MAX_IN_MEMORY_PARTS=2
MINIO_HEAL_TIMEOUT_SECONDS=3600
CAPACITY_SNAPSHOT_INTERVAL_SECONDS=3600
CAPACITY_SNAPSHOT_MAX_AGE_SECONDS=10800
DIAGNOSTIC_QUOTA_AGGREGATE_MAX_AGE_SECONDS=7200
CLUSTER_HEALTH_CHECK_INTERVAL_SECONDS=120
# A MinIO drive can be online while it has no space/inodes left.
MINIO_DRIVE_WARNING_PERCENT=85
MINIO_DRIVE_CRITICAL_PERCENT=95
MINIO_DRIVE_INODE_WARNING_PERCENT=85
MINIO_DRIVE_INODE_CRITICAL_PERCENT=95
MINIO_DRIVE_CAPACITY_SKEW_PERCENT=20
# 仅 SYNC_AUTHORITY_REGION 自动巡检在线但存在待修复磁盘的集群
AUTO_HEAL_ENABLED=true
AUTO_HEAL_COOLDOWN_SECONDS=21600

# ========== 日志 ==========
LOG_PATH=logs/
LOG_STD_LEVEL=INFO
LOG_STORAGE_LEVEL=INFO
LOG_STORAGE_DAYS=30

# ========== 企业 SSO（可选） ==========
IGNORE_AUTH=false
USER_INFO_URL=http://your-sso-server/api/v1/get_user

# ========== OA IM 身份验证 ==========
SPRINGBOARD_URL=http://tl.cooacloud.com/springboard_v3/
SPRINGBOARD_APP=storagent
FRONT_URL=http://stor.1oa.com.cn
OA_AUTH_CODE_EXPIRE_MINUTES=15
OA_AUTH_SEND_RETRIES=3

# ========== CORS ==========
# 生产环境必须配置具体域名，禁止 ["*"]
BACKEND_CORS_ORIGINS=["https://admin.example.com"]
